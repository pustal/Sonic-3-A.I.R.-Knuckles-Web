@@ -89,6 +107,23 @@
 
 void UpdateCheck::performUpdate()
 {
+#if defined(S3W_PORT_UPDATE_CHECK)
+	if (mState == State::WAITING_FOR_RESPONSE)
+	{
+		int portHasUpdate = 0;
+		const int portState = s3w_update_check_poll(&portHasUpdate);
+		if (portState == 2)			// S3W_UPDATE_CHECK_DONE
+		{
+			mAppUpdateCheckRequest.mResponse.mHasUpdate = (portHasUpdate != 0);
+			mState = State::HAS_RESPONSE;
+		}
+		else if (portState == 3)	// S3W_UPDATE_CHECK_FAILED
+		{
+			mState = State::FAILED;
+		}
+	}
+	return;
+#endif
 	EngineServerClient& engineServerClient = EngineServerClient::instance();
 	if (!engineServerClient.isConnected())
 	{
